    <!--
        ── Sisi KIRI  (bawah → atas, x=2) ──────────────────────────
    -->
    <!-- dash 1 -->
    <path android:pathData="M 2,114 L 2,108"      android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 2 -->
    <path android:pathData="M 2,104 L 2,98"       android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 3 -->
    <path android:pathData="M 2,94 L 2,88"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 4 -->
    <path android:pathData="M 2,84 L 2,78"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 5 -->
    <path android:pathData="M 2,74 L 2,68"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 6 -->
    <path android:pathData="M 2,64 L 2,58"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 7 -->
    <path android:pathData="M 2,54 L 2,48"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 8 -->
    <path android:pathData="M 2,44 L 2,38"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 9 -->
    <path android:pathData="M 2,34 L 2,28"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 10 -->
