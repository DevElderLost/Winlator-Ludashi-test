<?xml version="1.0" encoding="utf-8"?>
<!--
    dashed_frame.xml
    Border dashed persegi panjang sebagai placeholder saat window iconic/minimize.
    Dipakai di active_window_list_item.xml pada IVDashedFrame.
    Warna default abu-abu (#BDBDBD), override via app:tint dari layout.
    Ukuran kanvas 116×116dp (sama dengan layout_width/height di list item).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="116dp"
    android:height="116dp"
    android:viewportWidth="116"
    android:viewportHeight="116">

    <!--
        Border dashed dibuat dengan serangkaian garis pendek (dash) yang disusun
        mengikuti sisi-sisi persegi panjang.
        Stroke 1.5px, dash panjang 6px, gap 4px — proporsi yang terlihat jelas
        di ukuran 116dp namun tidak terlalu ramai.
        Margin dalam 2px dari tepi agar stroke tidak terpotong viewport.

        Android Vector tidak mendukung stroke-dasharray natively,
        sehingga setiap dash digambar sebagai path pendek terpisah.
        Pendekatan ini paling kompatibel lintas API level.

        ── Sisi ATAS  (kiri → kanan, y=2) ──────────────────────────
    -->

    <!-- dash 1 -->
    <path android:pathData="M 2,2 L 8,2"         android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 2 -->
    <path android:pathData="M 12,2 L 18,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 3 -->
    <path android:pathData="M 22,2 L 28,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 4 -->
    <path android:pathData="M 32,2 L 38,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 5 -->
    <path android:pathData="M 42,2 L 48,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 6 -->
    <path android:pathData="M 52,2 L 58,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 7 -->
    <path android:pathData="M 62,2 L 68,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 8 -->
    <path android:pathData="M 72,2 L 78,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 9 -->
    <path android:pathData="M 82,2 L 88,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 10 -->
    <path android:pathData="M 92,2 L 98,2"        android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- dash 11 -->
    <path android:pathData="M 102,2 L 108,2"      android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>
    <!-- partial dash 12 (sisa hingga pojok) -->
    <path android:pathData="M 112,2 L 114,2"      android:strokeColor="#FFBDBDBD" android:strokeWidth="1.5" android:strokeLineCap="square" android:fillColor="@android:color/transparent"/>

    <!--
        ── Sisi KANAN  (atas → bawah, x=114) ───────────────────────
