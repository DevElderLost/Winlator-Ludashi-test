<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/LLWindowCard"
    android:orientation="vertical"
    android:background="?panelBackground"
    android:padding="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true">

    <!--
        Header row: FrameLayout agar IBtnClose bisa overlay di pojok kanan.
        IBtnClose dideklarasi PERTAMA agar layout_toStartOf pada LLTitleRow
        bisa resolve ID-nya tanpa forward-reference issue.
        layout_width="match_parent" agar header selebar thumbnail di bawahnya.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <!-- Tombol X — dideklarasi dulu agar ID tersedia untuk layout_toEndOf -->
        <ImageButton
            android:id="@+id/IBtnClose"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:padding="2dp"
            android:background="@drawable/bg_window_close_button"
            android:src="@drawable/ic_window_close"
            android:scaleType="fitCenter"
            android:contentDescription="Close window"
            android:focusable="false"
            android:focusableInTouchMode="false"
            app:tint="#FF000000" />

        <!-- Icon + Title — margin kanan agar tidak overlap IBtnClose -->
        <LinearLayout
            android:id="@+id/LLTitleRow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingEnd="26dp">

            <ImageView
                android:id="@+id/IVIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/TVName"
                android:textSize="14sp"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />

        </LinearLayout>

    </FrameLayout>

    <!-- Area thumbnail window -->
    <FrameLayout
        android:layout_width="116dp"
        android:layout_height="116dp">

        <ImageView
            android:id="@+id/IVWindow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/IVDashedFrame"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/dashed_frame"
            app:tint="#FFBDBDBD" />

        <ImageView
            android:layout_gravity="center"
            android:id="@+id/IVHidden"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_hide"
            app:tint="#FFBDBDBD" />

    </FrameLayout>

</LinearLayout>
