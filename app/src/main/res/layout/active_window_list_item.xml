<?xml version="1.0" encoding="utf-8"?>
<!--
    active_window_list_item.xml
    Card thumbnail window untuk ActiveWindowsDialog — scroll horizontal.

    Struktur:
      FrameLayout (root, wrap_content)
      ├── LinearLayout#LLWindowCard   ← area klik "bring to front"
      │   ├── [icon + title header]
      │   └── FrameLayout
      │       ├── ImageView#IVWindow       ← thumbnail
      │       ├── ImageView#IVDashedFrame  ← tampil saat iconic/minimize
      │       └── ImageView#IVHidden       ← ikon mata tertutup saat iconic
      └── ImageButton#IBtnClose            ← tombol X, pojok kanan atas
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <!-- ── Card utama ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/LLWindowCard"
        android:orientation="vertical"
        android:background="?panelBackground"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <!-- Header: icon aplikasi + judul window -->
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/IVIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/TVName"
                android:textSize="14sp"
                android:ellipsize="end"
                android:paddingStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Area thumbnail window -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Screenshot thumbnail -->
            <ImageView
                android:id="@+id/IVWindow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY" />

            <!-- Frame dashed — tampil saat window iconic/minimize -->
            <ImageView
                android:id="@+id/IVDashedFrame"
                android:visibility="gone"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:src="@drawable/dashed_frame"
                app:tint="#FFBDBDBD" />

            <!-- Ikon "tersembunyi" — tampil di tengah saat iconic -->
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/IVHidden"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_hide"
                app:tint="#FFBDBDBD" />

        </FrameLayout>

    </LinearLayout>

    <!-- ── Tombol Close (X) — pojok kanan atas ────────────────── -->
    <!--
        background  = bg_window_close_button (transparan → merah saat hover/press)
        src         = ic_window_close  (vektor X bergaya Windows 11)
        app:tint    = #FFFFFF — ikon X putih, kontras baik di atas merah maupun gelap.
        Untuk override tint dari kode:
            ImageViewCompat.setImageTintList(btnClose, ColorStateList.valueOf(Color.WHITE));
    -->
    <ImageButton
        android:id="@+id/IBtnClose"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:padding="3dp"
        android:background="@drawable/bg_window_close_button"
        android:src="@drawable/ic_window_close"
        android:scaleType="fitCenter"
        android:contentDescription="Close window"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:tint="#FFFFFFFF" />

</FrameLayout>
