<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CursorPositionView mengisi penuh sebagai layer bawah -->
    <com.winlator.cmod.contentdialog.CursorPositionView
        android:id="@+id/cursorPositionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Label + SeekBar + BTReset overlay di atas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Label Offset Scale -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offset_scale"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="8dp" />

        <!-- Baris horizontal: SeekBar + Tombol Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarOffsetScale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="30"
                android:progress="10" />

            <ImageButton
                android:id="@+id/BTReset"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/icon_reset_24dp"
                android:contentDescription="Reset Hotspot" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
