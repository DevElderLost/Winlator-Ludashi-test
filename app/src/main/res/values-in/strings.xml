    <string name="help_xinput"><![CDATA[
        Jika game Anda menggunakan <i><b>XInput API</b></i> untuk dukungan kontroler game, harap aktifkan opsi ini.<br/><br/>
        Opsi ini akan mempengaruhi kontroler game <i><b>virtual</b></i> (disediakan oleh Kontrol Input) maupun <i><b>fisik</b></i>.
    ]]></string>
    <string name="help_dinput"><![CDATA[
        Jika game Anda menggunakan <i><b>DInput API</b></i> untuk dukungan kontroler game, harap aktifkan opsi ini.<br/><br/>
        Opsi ini akan mempengaruhi kontroler game <i><b>virtual</b></i> (disediakan oleh Kontrol Input) maupun <i><b>fisik</b></i>.
    ]]></string>
    <string name="enable_xinput_and_dinput_same_time">Beberapa game mungkin mendukung kedua API. Mengaktifkan XInput dan DInput secara bersamaan dalam game tersebut dapat menyebabkan masalah kontrol, seperti yang terlihat pada judul seperti The Binding of Isaac dan seri Resident Evil.</string>
    <string name="startup_normal">Normal (Muat semua layanan)</string>
    <string name="startup_essential">Esensial (Hanya muat layanan esensial)</string>
    <string name="startup_aggressive">Agresif (Hentikan layanan saat startup)</string>
    <string name="lc_all" translatable="false">LC_ALL</string>
    <string name="help_trigger_mode"><![CDATA[
        Opsi ini bergantung pada <i><b>Kontroler Fisik</b></i> yang Anda gunakan.<br/><br/>
        <i><b>Adalah Sumbu</b></i>: Centang ini jika trigger pada kontroler Anda bersifat linier (dengan rentang gerakan).<br/><br/>
        <i><b>Adalah Tombol</b></i>: Centang ini jika trigger pada kontroler Anda adalah tombol (mirip sakelar).<br/><br/>
        <i><b>Catatan</b></i>: Untuk trigger linier, menggunakan <i><b>Adalah Tombol</b></i> akan mengakibatkan hilangnya data linier saat pemetaan.<br/>
    ]]></string>
