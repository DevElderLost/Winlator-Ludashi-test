    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> adalah lapisan terjemahan untuk DirectX 1-11 ke OpenGL.<br /><br />
        <i><b>DXVK</b></i> adalah lapisan terjemahan untuk Direct3D 9-11 ke Vulkan.<br /><br />
        <i><b>VKD3D</b></i> adalah lapisan terjemahan untuk Direct3D 12 API ke Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> adalah implementasi DirectDraw untuk kompatibilitas yang lebih baik dengan game klasik.
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        Penanganan flag pada opcode CALL/RET<br /><br />
        <b>0</b> : Memperlakukan CALL/RET seolah tidak pernah membutuhkan flag (lebih cepat, tidak stabil)<br />
        <b>1</b> : Sebagian besar RET akan membutuhkan flag, sebagian besar CALL tidak<br />
        <b>2</b> : Semua CALL/RET akan membutuhkan flag (lebih lambat)
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">Pembangkitan -NAN seperti pada x86</string>
    <string name="box64_env_var_help__dynarec_fastround">Pembangkitan pembulatan x86 yang presisi</string>
    <string name="box64_env_var_help__dynarec_x87double">Penggunaan Float/Double untuk emulasi x87</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec membangun BigBlock<br /><br />
        <b>0</b> : Jangan mencoba membangun blok sebesar mungkin<br />
        <b>1</b> : Bangun blok Dynarec sebesar mungkin<br />
        <b>2</b> : Bangun blok Dynarec lebih besar (lanjutkan ketika blok tumpang tindih, tetapi hanya untuk blok di memori elf)<br />
        <b>3</b> : Bangun blok Dynarec lebih besar (lanjutkan ketika blok tumpang tindih, untuk semua jenis memori)
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulasi model Memori Kuat<br /><br />
        <b>0</b> : Jangan mencoba sesuatu yang khusus<br />
        <b>1</b> : Aktifkan beberapa Memory Barrier saat menulis ke memori (pada beberapa opcode MOV)<br />
        <b>2</b> : Semua 1 ditambah Memory Barrier pada setiap penulisan ke memori menggunakan MOV<br />
        <b>3</b> : Semua 2 ditambah Memory Barrier saat membaca dari memori dan pada beberapa opcode SSE/SSE2
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">Mendefinisikan nilai forward maksimum yang diizinkan saat membangun Blok</string>
    <string name="box64_env_var_help__dynarec_callret">Optimasi opcode CALL/RET</string>
    <string name="box64_env_var_help__dynarec_wait">Mendefinisikan apakah Dynarec akan menunggu FillBlock siap atau tidak</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        Sesuaikan memory barrier untuk mengurangi dampak performa dari emulasi memori kuat<br /><br />
        <b>0</b> : Gunakan barrier aman biasa<br />
        <b>1</b> : Gunakan weak barrier untuk peningkatan performa ringan<br />
        <b>2</b> : Gunakan weak barrier, selain itu nonaktifkan barrier tulis terakhir]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        Hasilkan hanya atomik yang selaras (hanya tersedia pada Arm64 untuk saat ini).<br /><br />
        <b>0</b> : Hasilkan kode penanganan atomik yang tidak selaras.<br />
        <b>1</b> : Hasilkan hanya atomik yang selaras, yang lebih cepat dan ukuran kode lebih kecil, tetapi akan menyebabkan SIGBUS untuk opcode dengan awalan LOCK yang beroperasi pada alamat data yang selaras.]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        Aktifkan atau nonaktifkan penggunaan flag yang ditangguhkan.<br /><br />
        <b>0</b> : Nonaktifkan penggunaan flag yang ditangguhkan.<br />
        <b>1</b> : Aktifkan penggunaan flag yang ditangguhkan.]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        Izinkan melanjutkan menjalankan blok yang tidak dilindungi dan berpotensi kotor.<br /><br />
        <b>0</b> : Jangan izinkan melanjutkan menjalankan blok yang tidak dilindungi dan berpotensi kotor.<br />
        <b>1</b> : Izinkan melanjutkan menjalankan dynablock yang menulis data di halaman yang sama dengan kode. Ini dapat mempercepat waktu loading beberapa game tetapi juga dapat menyebabkan crash yang tidak terduga.<br />
        <b>2</b> : Juga, ketika mendeteksi HotPage, tandai halaman tersebut sebagai NEVERCLEAN, sehingga tidak akan dilindungi penulisan tetapi Blok yang dibangun dari halaman tersebut akan selalu diuji. Cara ini bisa lebih cepat (tetapi beberapa kasus SMC mungkin tidak terdeteksi).]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        Aktifkan atau nonaktifkan penggunaan flag native.<br /><br />
        <b>0</b> : Jangan gunakan flag native.<br />
        <b>1</b> : Gunakan flag native jika memungkinkan.]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        Aktifkan emulasi x86 PAUSE, dapat membantu performa spinlock.<br /><br />
        <b>0</b> : Abaikan instruksi x86 PAUSE.<br />
        <b>1</b> : Gunakan YIELD untuk mengemulasi instruksi x86 PAUSE.<br />
        <b>2</b> : Gunakan WFI untuk mengemulasi instruksi x86 PAUSE.<br />
        <b>3</b> : Gunakan SEVL+WFE untuk mengemulasi instruksi x86 PAUSE.
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        AVX dan AVX2 diimplementasikan, bersama dengan ekstensi BMI1, BMI2, ADX, FMA, F16C dan RDANDR!<br /><br />
        <b>0</b> : Nonaktifkan ekstensi AVX<br />
        <b>1</b> : Aktifkan ekstensi AVX, BMI1, F16C dan VAES.<br />
        <b>2</b> : Semua 1 ditambah aktifkan AVX2, BMI2, FMA, ADX, VPCLMULQDQ dan RDRAND.<br />\
    ]]></string>
    <string name="box64_env_var_help__maxcpu">Jumlah maksimum CPU yang disajikan ke program oleh Box64</string>
    <string name="box64_env_var_help__unityplayer">Deteksi UnityPlayer.dll dan terapkan pengaturan strongmem</string>
    <string name="box64_env_var_help__mmap32">Paksa setiap alokasi memori di ruang alamat 32bit</string>
    <string name="fexcore_env_var_help__tsoenabled">Mengaktifkan operasi IR TSO (diperlukan untuk aplikasi multi-thread).</string>
    <string name="fexcore_env_var_help__vectortsoenabled">Membuat load/store vektor bersifat atomik ketika TSO diaktifkan.</string>
    <string name="fexcore_env_var_help__halfbarriertsoenabled">Menggunakan half-barrier atomics untuk load/store yang tidak selaras di bawah TSO.</string>
    <string name="fexcore_env_var_help__memcpysettsoenabled">Membuat REP MOVS / REP STOS bersifat atomik di bawah TSO.</string>
    <string name="fexcore_env_var_help__multiblock">Mengaktifkan kompilasi kode multiblok. Dapat menyebabkan kompilasi JIT yang lebih lama dan stutter.</string>
    <string name="fexcore_env_var_help__hostfeatures">Mengontrol pemaksaan fitur CPU.</string>
    <string name="fexcore_env_var_help__smalltscscale">Menskalakan TSC pada sistem berfrekuensi rendah.</string>
    <string name="fexcore_env_var_help__smc_checks">Pemeriksaan Self-Modifying Code.</string>
    <string name="fexcore_env_var_help__volatilemetadata">Menggunakan metadata volatile dari file PE untuk TSO jika tersedia.</string>
    <string name="fexcore_env_var_help__monohacks">Hack SMC + blok JIT khusus untuk deteksi Mono.</string>
    <string name="fexcore_env_var_help__hidehypervisorbit">Menyembunyikan bit hypervisor CPUID (berguna untuk aplikasi yang crash dengan bit tersebut).</string>
    <string name="fexcore_env_var_help__disablel2cache">Menonaktifkan pencarian cache L2 JIT FEXCore, menghemat memori tetapi menyebabkan stutter.</string>
    <string name="fexcore_env_var_help__dynamicl1cache">Mengalihkan cache L1 JIT FEXCore ke ukuran dinamis, menghemat memori tetapi menyebabkan stutter.</string>
    <string name="fexcore_env_var_help__x87reducedprecision">Mengemulasi floating point X87 menggunakan presisi 64-bit. Ini mengurangi akurasi emulasi dan dapat mengakibatkan bug rendering.</string>
