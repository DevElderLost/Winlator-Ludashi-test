    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> é uma camada de tradução para DirectX 1-11 para OpenGL.<br /><br />
        <i><b>DXVK</b></i> é uma camada de tradução para Direct3D 9-11 para Vulkan.<br /><br />
        <i><b>VKD3D</b></i> é uma camada de tradução para a API Direct3D 12 para Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> é uma implementação do DirectDraw para melhor compatibilidade com jogos clássicos.
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        Tratamento de flags nos opcodes CALL/RET<br /><br />
        <b>0</b> : Trata CALL/RET como se nunca precisasse de flags (mais rápido, instável)<br />
        <b>1</b> : A maioria dos RET precisará de flags, a maioria dos CALLS não<br />
        <b>2</b> : Todos CALL/RET precisarão de flags (mais lento)
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">Geração de -NAN como no x86</string>
    <string name="box64_env_var_help__dynarec_fastround">Geração de arredondamento x86 preciso</string>
    <string name="box64_env_var_help__dynarec_x87double">Uso de Float/Double para emulação x87</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Construção de BigBlock pelo Dynarec<br /><br />
        <b>0</b> : Não tenta construir blocos tão grandes quanto possível<br />
        <b>1</b> : Constrói bloco Dynarec tão grande quanto possível<br />
        <b>2</b> : Constrói bloco Dynarec maior (continua quando o bloco se sobrepõe, mas apenas para blocos na memória elf)<br />
        <b>3</b> : Constrói bloco Dynarec maior (continua quando o bloco se sobrepõe, para todos os tipos de memória)
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulação do modelo de Memória Forte<br /><br />
        <b>0</b> : Não tenta nada especial<br />
        <b>1</b> : Ativa algumas Barreiras de Memória ao escrever na memória (em alguns opcodes MOV)<br />
        <b>2</b> : Tudo do 1 mais uma Barreira de Memória em cada escrita na memória usando MOV<br />
        <b>3</b> : Tudo do 2 mais Barreira de Memória ao ler da memória e em alguns opcodes SSE/SSE2
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">Define o valor máximo de avanço permitido ao construir o Bloco</string>
    <string name="box64_env_var_help__dynarec_callret">Otimização dos opcodes CALL/RET</string>
    <string name="box64_env_var_help__dynarec_wait">Define se o Dynarec vai aguardar o FillBlock estar pronto ou não</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        Ajusta as barreiras de memória para reduzir o impacto no desempenho da emulação de memória forte<br /><br />
        <b>0</b> : Usa barreiras seguras regulares<br />
        <b>1</b> : Usa barreiras fracas para leve melhoria de desempenho<br />
        <b>2</b> : Usa barreiras fracas, adicionalmente desativa as últimas barreiras de escrita]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        Gera apenas atômicos alinhados (disponível apenas em Arm64 por enquanto).<br /><br />
        <b>0</b> : Gera código de tratamento de atômicos não alinhados.<br />
        <b>1</b> : Gera apenas atômicos alinhados, que é mais rápido e tem menor tamanho de código, mas causará SIGBUS para opcodes prefixados com LOCK operando em endereços de dados alinhados.]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        Ativa ou desativa o uso de flags diferidos.<br /><br />
        <b>0</b> : Desativa o uso de flags diferidos.<br />
        <b>1</b> : Ativa o uso de flags diferidos.]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        Permite continuar executando um bloco desprotegido e potencialmente sujo.<br /><br />
        <b>0</b> : Não permite continuar executando um bloco desprotegido e potencialmente sujo.<br />
        <b>1</b> : Permite continuar executando um dynablock que grava dados na mesma página que o código. Isso pode acelerar o tempo de carregamento de alguns jogos, mas também pode causar crashes inesperados.<br />
        <b>2</b> : Também, quando detectar uma HotPage, marca essa página como NEVERCLEAN, de modo que não será protegida contra escrita, mas os Blocos construídos nessa página sempre serão testados. Isso pode ser mais rápido (mas alguns casos de SMC podem não ser capturados).]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        Ativa ou desativa o uso de flags nativas.<br /><br />
        <b>0</b> : Não usa flags nativas.<br />
        <b>1</b> : Usa flags nativas quando possível.]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        Ativa emulação x86 PAUSE, pode ajudar no desempenho de spinlocks.<br /><br />
        <b>0</b> : Ignora instrução x86 PAUSE.<br />
        <b>1</b> : Usa YIELD para emular instrução x86 PAUSE.<br />
        <b>2</b> : Usa WFI para emular instrução x86 PAUSE.<br />
        <b>3</b> : Usa SEVL+WFE para emular instrução x86 PAUSE.
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        AVX e AVX2 implementados, junto com extensões BMI1, BMI2, ADX, FMA, F16C e RDANDR!<br /><br />
        <b>0</b> : Desativa extensão AVX<br />
        <b>1</b> : Ativa AVX, BMI1, F16C e extensão VAES.<br />
        <b>2</b> : Tudo do 1 mais ativa AVX2, BMI2, FMA, ADX, VPCLMULQDQ e RDRAND.<br />\
    ]]></string>
    <string name="box64_env_var_help__maxcpu">Número máximo de CPUs apresentado aos programas pelo Box64</string>
    <string name="box64_env_var_help__unityplayer">Detecta UnityPlayer.dll e aplica configurações de strongmem</string>
    <string name="box64_env_var_help__mmap32">Força toda alocação de memória em espaços de endereço de 32bit</string>
    <string name="fexcore_env_var_help__tsoenabled">Ativa operações IR de TSO (necessário para aplicativos multithread).</string>
    <string name="fexcore_env_var_help__vectortsoenabled">Torna load/stores vetoriais atômicos quando TSO está ativado.</string>
    <string name="fexcore_env_var_help__halfbarriertsoenabled">Usa half-barrier atomics para loads/stores não alinhados sob TSO.</string>
    <string name="fexcore_env_var_help__memcpysettsoenabled">Torna REP MOVS / REP STOS atômicos sob TSO.</string>
    <string name="fexcore_env_var_help__multiblock">Ativa compilação de código multibloco. Pode causar compilação JIT mais longa e travamentos.</string>
    <string name="fexcore_env_var_help__hostfeatures">Controla o forçamento de recursos da CPU.</string>
    <string name="fexcore_env_var_help__smalltscscale">Escala TSC em sistemas de baixa frequência.</string>
    <string name="fexcore_env_var_help__smc_checks">Verificações de Self-Modifying Code.</string>
    <string name="fexcore_env_var_help__volatilemetadata">Usa metadados voláteis de arquivos PE para TSO quando disponíveis.</string>
    <string name="fexcore_env_var_help__monohacks">Hacks especiais de SMC + bloco JIT para detecção do Mono.</string>
    <string name="fexcore_env_var_help__hidehypervisorbit">Oculta o bit de hypervisor do CPUID (útil para aplicativos que travam com ele).</string>
    <string name="fexcore_env_var_help__disablel2cache">Desativa a busca de cache L2 JIT do FEXCore, economizando memória mas introduzindo travamentos.</string>
    <string name="fexcore_env_var_help__dynamicl1cache">Alterna o cache L1 JIT do FEXCore para tamanho dinâmico, economizando memória mas introduzindo travamentos.</string>
    <string name="fexcore_env_var_help__x87reducedprecision">Emula ponto flutuante X87 usando precisão de 64 bits. Isso reduz a precisão da emulação e pode resultar em bugs de renderização.</string>
